typedef struct {
	  uint8_t  RunNow;
	  uint8_t  Cycle;
    uint16_t Temperature;
    uint16_t Humidity;
    uint16_t SetTime;
	  uint8_t  EndCount;
} ProModeStruct;



ProModeStruct *ProModeStructment = NULL;
float TempValue, HumidityValue;
void ProgramAPP(partab_type *pTab, TypeCtrl *pSensorValue)
{
    ProModeStructment = (ProModeStruct *)pTab;
    ParUnSaved[PAR_POS_CURRENT_STEP].uVal=ProModeStructment->RunNow;
    if (pSensorValue->Flag.CurrentModeState == ProgramModeID && ParTab[PAR_POS_Run_Stop_Command].uVal) {
        if ( ProModeStructment->RunNow <  ParTab[PAR_POS_TEMP_PROGRAM_END_COUNT].uVal) {
					  pSensorValue->SetRunTime = ProModeStructment->SetTime;
            ParTab[PAR_POS_TEMP_PRO_SV].uVal =ProModeStructment->Temperature;
            ParTab[PAR_POS_HUMI_PRO_SV].uVal 		= ProModeStructment->Humidity;
            HumidityValue = pSensorValue->Parameter[HumidityID].Measure -ProModeStructment->Humidity;
            TempValue = pSensorValue->Parameter[TemperatureID].Measure - ProModeStructment->Temperature;
            if (fabs(HumidityValue) < ParTab[PAR_POS_HUMI_DIFF_COUNT].uVal &&
                    fabs(TempValue) < ParTab[PAR_POS_TEMP_DIFF_COUNT].uVal) {
                     pSensorValue->Flag.EnTime = 1;  
                if (pSensorValue->RunTime  >= ProModeStructment->SetTime * 60) {
                    pSensorValue->RunTime = 0;
                    ProModeStructment->RunNow++;
									 if(ProModeStructment->RunNow >= ProModeStructment->EndCount)
									 {
										 if( ProModeStructment->Cycle >0 )
										 {
										 	pSensorValue->Flag.EnTime = 0;
										  ProModeStructment->RunNow = 0;
										 }else
										 {
										  ParTab[PAR_POS_Run_Stop_Command].uVal = 0;
										  pSensorValue->Flag.EnTime = 0;
										 }
									 }
                }
            } else {
                pSensorValue->Flag.EnTime = 0;
            }
        } else  {
                   pSensorValue->Flag.EnTime = 0 ; 
        }
    }else  ProModeStructment->RunNow = 0;
}




void Temp_Hea_State(bool state)
{
    state == Heat_OFF  ? HEAT_OFF : HEAT_ON;
}

void Hum_Hea_State(bool state)
{
    state == Heat_OFF ? Hum_HEAT_OFF : Hum_HEAT_ON;
}




