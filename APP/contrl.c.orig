			  if(SensorType.Flag.CurrentModeState ==  ProgramModeID)
			  ProgramAPP(&ParTab[PAR_POS_PRO_RUN_ROW], &SensorType);
				else
				{
      
        Control(&SensorType.Parameter[TemperatureID], &SensorType.Flag);
        Control(&SensorType.Parameter[HumidityID], &SensorType.Flag);
				}
        osDelay(10);
    }

    /* USER CODE END ProgramemodeTask */
}






